#!/bin/bash
# clones the two repos and runs the setup script from Mint-Bench
# log is at /var/log/user-data.log, /var/log/mint-ready shows up when it worked
exec > >(tee -a /var/log/user-data.log) 2>&1
set -euxo pipefail
export DEBIAN_FRONTEND=noninteractive
export HOME=/root

apt-get update
apt-get install -y git

git clone --depth 1 https://github.com/Dhiren9939/Mint-Bench.git /opt/src/Mint-Bench
git clone --depth 1 --branch bench-sql-lua https://github.com/Dhiren9939/Mint.git /opt/src/Mint

export MINT_DIR=/opt/src/Mint
export BENCH_DIR=/opt/src/Mint-Bench
export DB_HOST='${db_host}'
export DB_USERNAME='${db_username}'
export DB_PASSWORD='${db_password}'
bash /opt/src/Mint-Bench/bench-sql/setup-ec2.sh

touch /var/log/mint-ready
