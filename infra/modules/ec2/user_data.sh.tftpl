#!/bin/bash
# sets up the whole app on this one box: postgres, redis, the api with the frontend, and caddy
# log is at /var/log/user-data.log, /var/log/mint-ready shows up when it worked, /var/log/mint-failed when it didn't.
# PHASE lines carry the seconds since boot, the deploy prints them
exec > >(tee -a /var/log/user-data.log) 2>&1
set -euxo pipefail
trap 'touch /var/log/mint-failed' ERR
export DEBIAN_FRONTEND=noninteractive
export HOME=/root

SRC=/opt/src/Mint
CONFIG=/opt/mint-backend/config
COMPOSE="docker compose --env-file /opt/mint-backend/.env -f $CONFIG/docker-compose.prod.yml"
IMAGE=${image}

phase() { set +x; echo "PHASE $(cut -d' ' -f1 /proc/uptime)s $1"; set -x; }
phase start

# the code comes down while apt runs, python is always there for cloud-init
mkdir -p $SRC
python3 -c "import urllib.request,sys; sys.stdout.buffer.write(urllib.request.urlopen(sys.argv[1]).read())" \
  "${trimsuffix(repo_url, ".git")}/archive/refs/heads/${repo_branch}.tar.gz" | tar -xz -C $SRC --strip-components 1 &
FETCH=$!

# debian's own docker, one apt update and no extra repo. recommends would pull needrestart and friends
apt-get update
apt-get install -y --no-install-recommends docker.io docker-cli docker-compose apparmor ca-certificates
systemctl enable --now docker
phase docker

wait $FETCH

# config the api container mounts, and the files compose needs next to it
mkdir -p $CONFIG
cp $SRC/backend/config/*.properties $SRC/backend/config/Caddyfile $SRC/backend/docker-compose.prod.yml $CONFIG
cp $SRC/.github/workflows/scripts/schema.sql $CONFIG
chmod -R 755 /opt/mint-backend

# secrets stay out of the folder the api mounts
cat > /opt/mint-backend/.env <<ENV
IMAGE_TAG=$IMAGE
DOMAIN=${domain}
USER_FILES_BUCKET=${user_files}
DB_USERNAME=${db_username}
DB_PASSWORD=${db_password}
ENV
chmod 600 /opt/mint-backend/.env

# caddy keeps its certs in s3, so a rebuilt box doesn't ask let's encrypt for a new one
mkdir -p /opt/mint-backend/caddy-data
cat > /usr/local/bin/caddy-cert-sync <<'SYNC'
#!/bin/bash
# usage: caddy-cert-sync down|up
set -euo pipefail
if [ "$1" = down ]; then
  src=${cert_backup}/; dst=/data
else
  src=/data; dst=${cert_backup}/
fi
docker run --rm -e AWS_DEFAULT_REGION=ap-south-1 -v /opt/mint-backend/caddy-data:/data amazon/aws-cli s3 sync "$src" "$dst" --only-show-errors
SYNC
chmod +x /usr/local/bin/caddy-cert-sync

cat > /etc/systemd/system/caddy-cert-sync.service <<UNIT
[Service]
Type=oneshot
ExecStart=/usr/local/bin/caddy-cert-sync up
UNIT
cat > /etc/systemd/system/caddy-cert-sync.timer <<UNIT
[Timer]
OnBootSec=5min
OnUnitActiveSec=10min
[Install]
WantedBy=timers.target
UNIT
systemctl daemon-reload
systemctl enable --now caddy-cert-sync.timer

# every image at once, next to the cert restore
(/usr/local/bin/caddy-cert-sync down || true) &
RESTORE=$!
if ! $COMPOSE pull -q; then
  # ghcr didn't give us the app image, build it here. 1gb of ram needs swap for that
  fallocate -l 2G /swapfile
  chmod 600 /swapfile
  mkswap /swapfile
  swapon /swapfile
  echo '/swapfile none swap sw 0 0' >> /etc/fstab
  apt-get install -y --no-install-recommends docker-buildx
  IMAGE=mint-backend:local
  sed -i "s|^IMAGE_TAG=.*|IMAGE_TAG=$IMAGE|" /opt/mint-backend/.env
  docker build -f $SRC/backend/Dockerfile -t $IMAGE $SRC
  docker builder prune -af
  $COMPOSE pull -q postgres redis caddy
fi
wait $RESTORE
phase images

$COMPOSE up -d --wait --wait-timeout 300
phase ready

touch /var/log/mint-ready
